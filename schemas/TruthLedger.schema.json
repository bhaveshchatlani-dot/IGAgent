{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TruthLedger",
  "type": "object",
  "required": ["as_of", "rows", "caption_lines_allowed", "sources"],
  "properties": {
    "as_of": { "type": "string", "format": "date-time" },

    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },

    "caption_lines_allowed": {
      "type": "array",
      "items": { "type": "string" }
    },

    "sources": {
      "type": "object",
      "required": ["market_snapshot_note", "signals_note"],
      "properties": {
        "market_snapshot_note": { "type": "string" },
        "signals_note": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "row": {
      "type": "object",
      "required": ["ticker", "close_str", "pct_str", "direction"],
      "properties": {
        "ticker": { "type": "string", "minLength": 1 },
        "close_str": { "type": "string", "minLength": 1 },
        "pct_str": { "type": "string", "minLength": 1 },
        "direction": { "type": "string", "enum": ["UP", "DOWN", "FLAT"] }
      },
      "additionalProperties": false
    }
  }
}