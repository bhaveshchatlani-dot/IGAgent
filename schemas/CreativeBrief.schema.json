{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreativeBrief",
  "type": "object",
  "required": [
    "template",
    "timeframe",
    "as_of",
    "aspect_ratio",
    "context_line",
    "footer_disclaimer",
    "rows",
    "image_prompt",
    "render_payload"
  ],
  "properties": {
    "template": { "type": "string" },
    "timeframe": { "type": "string", "enum": ["1D", "1W", "1M"] },
    "as_of": { "type": "string", "format": "date-time" },
    "aspect_ratio": { "type": "string", "enum": ["1:1", "4:5"] },

    "context_line": { "type": "string", "minLength": 1 },
    "footer_disclaimer": { "type": "string", "minLength": 1 },

    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ticker", "close_str", "pct_str", "direction", "arrow"],
        "properties": {
          "ticker": { "type": "string" },
          "close_str": { "type": "string" },
          "pct_str": { "type": "string" },
          "direction": { "type": "string", "enum": ["UP", "DOWN", "FLAT"] },
          "arrow": { "type": "string", "enum": ["↑", "↓", "→"] }
        },
        "additionalProperties": false
      }
    },

    "image_prompt": { "type": "string", "minLength": 1 },

    "render_payload": {
      "type": "object",
      "required": ["header_line", "gainers", "biggest_winner", "biggest_loser", "decliners"],
      "properties": {
        "header_line": { "type": "string", "minLength": 1 },

        "gainers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["ticker", "pct", "icon_key"],
            "properties": {
              "ticker": { "type": "string", "minLength": 1 },
              "pct": { "type": "string", "minLength": 1 },
              "icon_key": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },

        "biggest_winner": {
          "type": "object",
          "required": ["ticker", "pct", "icon_key"],
          "properties": {
            "ticker": { "type": "string", "minLength": 1 },
            "pct": { "type": "string", "minLength": 1 },
            "icon_key": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },

        "biggest_loser": {
          "type": "object",
          "required": ["ticker", "pct", "icon_key"],
          "properties": {
            "ticker": { "type": "string", "minLength": 1 },
            "pct": { "type": "string", "minLength": 1 },
            "icon_key": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },

        "decliners": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["ticker", "pct", "icon_key"],
            "properties": {
              "ticker": { "type": "string", "minLength": 1 },
              "pct": { "type": "string", "minLength": 1 },
              "icon_key": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}