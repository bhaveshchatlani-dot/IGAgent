{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreativeBrief",
  "type": "object",
  "required": [
    "template",
    "timeframe",
    "as_of",
    "aspect_ratio",
    "context_line",
    "footer_disclaimer",
    "rows",
    "image_prompt"
  ],
  "properties": {
    "template": { "type": "string" },
    "timeframe": { "type": "string", "enum": ["1D", "1W", "1M"] },
    "as_of": { "type": "string", "format": "date-time" },
    "aspect_ratio": { "type": "string", "enum": ["1:1", "4:5"] },

    "context_line": { "type": "string", "minLength": 1 },
    "footer_disclaimer": { "type": "string", "minLength": 1 },

    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ticker", "close_str", "pct_str", "direction", "arrow"],
        "properties": {
          "ticker": { "type": "string" },
          "close_str": { "type": "string" },
          "pct_str": { "type": "string" },
          "direction": { "type": "string", "enum": ["UP", "DOWN", "FLAT"] },
          "arrow": { "type": "string", "enum": ["↑", "↓", "→"] }
        },
        "additionalProperties": false
      }
    },

    "image_prompt": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}